{
    "compileOnSave": true,
    "compilerOptions": {
        "target": "es2023",
        "lib": [
            "es2023",
            "dom"
        ],
        "module": "commonjs",
        "resolveJsonModule": true,
        "types": ["node", "jest"],

        "strict": true,
        "strictFunctionTypes": true,
        "strictPropertyInitialization": false,
        "strictBuiltinIteratorReturn": false,
        "noImplicitOverride": true,
        "declaration": true,
        "inlineSources": true,
        "preserveConstEnums": true,
        "removeComments": false,
        "sourceMap": true
    },
    "include": [
        "engines/*/bin/**/*",
        "engines/*/lib/**/*",
        "packages/*/bin/**/*",
        "packages/*/lib/**/*"
    ],
    "exclude": [
        "**/node_modules"
    ]
}
